{
  "name": "mcp-duckduckgo",
  "version": "1.0.0",
  "description": "MCP server for DuckDuckGo search and web content extraction",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx src/example.ts"
  },
  "keywords": [
    "mcp",
    "duckduckgo",
    "search",
    "web-scraping"
  ],
  "author": "AstroCorp",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/turndown": "^5.0.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
